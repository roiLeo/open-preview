    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "nuxt": "^4.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.0",
    "@nuxtjs/i18n": "^10.6.0",
    "cheerio": "^1.2.0"
  },
