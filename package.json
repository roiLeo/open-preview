      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@nuxt/devtools": "4.0.0-alpha.16",
    "@nuxt/eslint-config": "^1.17.0",
    "eslint": "^10.9.1",
